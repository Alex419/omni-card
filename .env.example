# Copy to .env for local development if you want feedback to go to Supabase.
# Without these, feedback is appended to .data/feedback.jsonl instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Optional
PORT=8787

# Analytics: written to Supabase when configured above, else to .data/analytics.jsonl.
# ANALYTICS_SECRET=any-long-random-string
# ANALYTICS=off   # record nothing
